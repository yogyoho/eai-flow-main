# SQLite by default; switch to PostgreSQL without changing code.
# WORKFLOW_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eai
WORKFLOW_DATABASE_URL=sqlite+aiosqlite:///./workflow.db

# Comma separated browser origins allowed to call the API.
WORKFLOW_CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020

# Defaults for requests without X-Tenant-Id.
WORKFLOW_TENANT_ID=000000

# SQLite/demo convenience. Production runs `alembic upgrade head` and sets 0.
WORKFLOW_AUTO_CREATE_SCHEMA=1

# Seed the three demo definitions and two demo forms on first start.
WORKFLOW_SEED_DEMO=1
# Seed the sales R4/R6/duplicate approval forms and published processes.
WORKFLOW_SEED_SALES_APPROVALS=1

# local: trust X-User-* headers (tests/demo). eai: validate the shared JWT and
# resolve permissions via the Gateway.
WORKFLOW_AUTH_MODE=local
EAI_BASE_URL=http://127.0.0.1:8001
EAI_TIMEOUT_SECONDS=4
PERMISSION_CACHE_TTL_SECONDS=60
# Must match the Gateway/JWT issuer secret.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_COOKIE=access_token
# Trusted BFF calls from sales-service (X-Workflow-Internal-Token).
WORKFLOW_INTERNAL_TOKEN=

# Log every SQL statement.
WORKFLOW_SQL_ECHO=0

# Temporal execution engine. Set TEMPORAL_ENABLED=0 for the standalone
# in-process demo. In Docker use TEMPORAL_URL=temporal:7233.
TEMPORAL_ENABLED=1
TEMPORAL_URL=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=workflow-engine-queue
TEMPORAL_RPC_TIMEOUT_SECONDS=5
TEMPORAL_PROBE_TIMEOUT_SECONDS=1.5
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=20
TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=20
WORKFLOW_INSTANCE_WORKFLOW_ID_PREFIX=flow-instance

# Durable command inbox / dispatcher.
WORKFLOW_COMMAND_WAIT_TIMEOUT_SECONDS=5
WORKFLOW_COMMAND_DISPATCH_INTERVAL_SECONDS=2
WORKFLOW_COMMAND_MAX_ATTEMPTS=10
WORKFLOW_COMMAND_STALE_SECONDS=120
WORKFLOW_COMMAND_ACTIVITY_TIMEOUT_SECONDS=30
WORKFLOW_COMMAND_ACTIVITY_MAX_ATTEMPTS=10
WORKFLOW_COMMAND_BACKOFF_BASE_SECONDS=2

# Marketing BFF event callback. Empty marks outbox events as SKIPPED instead of
# retrying forever; set this in production and share the HMAC secret.
WORKFLOW_EVENT_WEBHOOK_URL=
WORKFLOW_EVENT_WEBHOOK_SECRET=
WORKFLOW_EVENT_WEBHOOK_TIMEOUT_SECONDS=5
WORKFLOW_OUTBOX_DISPATCH_INTERVAL_SECONDS=3
WORKFLOW_OUTBOX_MAX_ATTEMPTS=10
WORKFLOW_OUTBOX_STALE_SECONDS=120
WORKFLOW_OUTBOX_BACKOFF_BASE_SECONDS=5

# Scheduled command/workflow/outbox reconciliation.
WORKFLOW_RECONCILE_INTERVAL_SECONDS=300
WORKFLOW_RECONCILE_STALE_SECONDS=120
WORKFLOW_RECONCILE_BATCH_SIZE=50

# Public base URL used when the frontend builds links back to the platform.
WORKFLOW_PUBLIC_BASE_URL=http://localhost:3020/workflow
WORKFLOW_LOG_LEVEL=INFO
