{
  "mcpServers": {
    "filesystem": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/allowed/files"
      ],
      "env": {},
      "cwd": null,
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "Provides filesystem access within allowed directories"
    },
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": ""
      },
      "cwd": null,
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "cwd": null,
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "PostgreSQL database access"
    },
    "project": {
      "enabled": true,
      "type": "stdio",
      "command": "/app/backend/.venv/bin/python",
      "args": [
        "-m",
        "app.extensions.project.mcp"
      ],
      "env": {
        "PROJECT_DB_URL": "postgresql+asyncpg://agentflow:agentflow123@postgres-ext:5432/agentflow"
      },
      "cwd": "/app/backend",
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "Project chapter read/write tools for report writing agent"
    },
    "knowledge-factory": {
      "enabled": true,
      "type": "http",
      "command": null,
      "args": [],
      "env": {},
      "cwd": null,
      "url": "http://knowledge-factory:8765/mcp",
      "headers": {},
      "oauth": null,
      "description": "Knowledge factory template resolution and domain listing tools for report generation (HTTP long-lived standalone process — avoids stdio cold-start race; container defined in docker-compose.extensions.yaml)"
    },
    "word-document-server": {
      "enabled": true,
      "type": "stdio",
      "command": "/app/backend/.venv/bin/python",
      "args": [
        "/app/mcp-server/Office-Word-MCP-Server/word_mcp_server.py"
      ],
      "env": {
        "PYTHONPATH": "/app/mcp-server/Office-Word-MCP-Server",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "cwd": "/app/mcp-server/Office-Word-MCP-Server",
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "Word document creation (54 tools)"
    },
    "cad": {
      "enabled": true,
      "type": "http",
      "command": null,
      "args": [],
      "env": {},
      "cwd": null,
      "url": "http://cad:8003/mcp",
      "headers": {},
      "oauth": null,
      "description": "CAD comprehension (DXF parse + rasterize) for fire-protection/EIA drawing ingestion. Standalone container (docker-compose.mcp-cad.yaml `cad` service)."
    },
    "text-to-cad": {
      "enabled": true,
      "type": "http",
      "command": null,
      "args": [],
      "env": {},
      "cwd": null,
      "url": "http://text-to-cad:8004/mcp",
      "headers": {},
      "oauth": null,
      "description": "text-to-cad: generate STEP/STL from agent-authored build123d source. Standalone container (docker-compose.mcp-cad.yaml `text-to-cad` service)."
    }
  },
  "skills": {
    "fire-protection-report": {
      "enabled": true
    },
    "fire-protection-report-v2": {
      "enabled": false
    },
    "fire-protection-extract": {
      "enabled": true
    }
  }
}
