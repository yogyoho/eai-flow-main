# =============================================================================
# EAI-Flow 生产离线部署 — 环境变量模板（.env 的 gitignored 替身）
# =============================================================================
# deploy/offline/.env 是机器本地文件（含密钥，已 gitignore）。fresh clone 上没有它，
# offline-export.sh 会用本模板引导生成——用前必填以下三项密钥：
#   1. BETTER_AUTH_SECRET          openssl rand -base64 32
#   2. RAGFLOW_SECRET_KEY          openssl rand -base64 32（部署后永不更改）
#   3. INTERNAL_LLM_API_KEY        内网 LLM 鉴权（不需要鉴权可留 sk-placeholder）
# 其余按实际环境核对：DEER_FLOW_ROOT / DEER_FLOW_TRUSTED_ORIGINS / 品牌 / 云端模型 Key。
# =============================================================================

# ── 部署目录（必填：离线包解压后的绝对路径）────────────────────────────────
DEER_FLOW_ROOT=/opt/eai-flow-offline

# ── 对外端口（浏览器访问端口）────────────────────────────────────────────
PORT=4026

# ── 内网访问域名/IP（Next.js dev 模式 allowedDevOrigins，逗号分隔）─────────
INTRANET_HOSTS=localhost

# ── 受信来源（CSRF / 跨域，必填：通过服务器 IP 访问必须列出，否则登录被拒）──
DEER_FLOW_TRUSTED_ORIGINS=http://localhost:4026

# ── 会话安全（必填：openssl rand -base64 32）──────────────────────────────
BETTER_AUTH_SECRET=

# ── RAGFlow API Key（法规库种子 + geo 样例库推送；部署后在 RAGFlow UI 生成回填）──
RAGFLOW_API_KEY=

# ── 内网 LLM API Key ────────────────────────────────────────────────────
INTERNAL_LLM_API_KEY=sk-placeholder

# ── 云端模型 API Keys（内网可连外网时填写）────────────────────────────────
AGNES_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# ── RAGFlow SECRET_KEY（v0.27.x 必需：openssl rand -base64 32，部署后永不更改）──
RAGFLOW_SECRET_KEY=

# ── geo 样例库 RAGFlow 推送 dataset id（留空=跳过推送）────────────────────
GSB_RAGFLOW_DATASET_ID=

# ── 环境标识 / 主目录 ────────────────────────────────────────────────────
DEER_FLOW_ENV=production
HOME=/root

# ── Extensions PostgreSQL ────────────────────────────────────────────────
POSTGRES_EXT_USER=agentflow
POSTGRES_EXT_PASSWORD=agentflow123
POSTGRES_EXT_DB=agentflow
POSTGRES_EXT_PORT=15432

# Extensions 模块数据库连接（Gateway 容器内使用 Docker 服务名）
EXTENSIONS_DB_HOST=postgres-ext
EXTENSIONS_DB_PORT=5432
EXTENSIONS_DB_USER=agentflow
EXTENSIONS_DB_PASSWORD=agentflow123
EXTENSIONS_DB_NAME=agentflow

# ── RAGFlow ──────────────────────────────────────────────────────────────
RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.1-fixed
RAGFLOW_WEB_PORT=19381
RAGFLOW_PORT=19380
RAGFLOW_HTTP_PROXY=
ELASTIC_PASSWORD=ragflow123
MYSQL_ROOT_PASSWORD=ragflow123
MYSQL_DATABASE=ragflow
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
ES_PORT=19200
MYSQL_PORT=13306
REDIS_PORT=16379
REDIS_PASSWORD=ragflow123
MINIO_API_PORT=19100
MINIO_CONSOLE_PORT=19101

# ── Gateway / Temporal / CAD Viewer ─────────────────────────────────────
GATEWAY_WORKERS=4
TEMPORAL_PORT=27233
CAD_VIEWER_PORT=14178
