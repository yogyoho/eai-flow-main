  "cards": [
    {
      "dot": "cyan",
      "title": "两道确认门",
      "items": [
        "门1：ingest.py check 输出 GATE1_COMPLETE 才写笔，缺项译成中文清单补齐",
        "门2：rc=3 异常清单必须逐条获用户确认，免打扰指令的法定例外",
        "确认门不可静默放行，只能「按冻结值继续」"
      ]
    },
    {
      "dot": "rose",
      "title": "唯一写者铁律",
      "items": [
        "data/ 唯一写者 = ingest.py，绝不手写 JSON",
        "chapter_planner 出章节清单；formula_state 唯一写者 = formula_runner.py",
        "交付只走 build_output.py，outputs/ 出现其他 .md = FAIL"
      ]
    },
    {
      "dot": "emerald",
      "title": "溯源与防篡改",
      "items": [
        "snapshot.py 全文件 SHA-256 清单，rc=3 = 被篡改即停",
        "delivery_manifest.json 在场才可交付，.delivery-contract 勿删",
        "consistency 22 合约（XS/FC/CC/NR/SL），FAIL>0 不可交付；只信 state/ 文件与 progress.json，不信对话记忆"
      ]
    }
  ]
