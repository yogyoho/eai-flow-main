    { "id": "runner", "lane": "scripts", "col": 1, "type": "messagebus", "label": "冻结计算", "sublabel": "formula_runner.py execute", "tag": "Decimal ROUND_HALF_EVEN", "width": 172 },
    { "id": "state_write", "lane": "scripts", "col": 2, "type": "database", "label": "冻结值入库", "sublabel": "state/formula_state.json", "tag": "唯一写者 · 每槽 source", "width": 170 },
    { "id": "gate2", "lane": "scripts", "col": 3, "type": "security", "label": "门 2 · 退出码判定", "sublabel": "progress.py run-stage freeze", "tag": "rc=0 / rc=3 / 全 0 空", "width": 184 },
    { "id": "confirm", "lane": "user", "col": 4, "type": "frontend", "label": "逐条异常确认", "sublabel": "ask_clarification · 只给按冻结值继续", "tag": "免打扰法定例外", "width": 214 },
    { "id": "halt_zero", "lane": "scripts", "col": 4, "type": "backend", "label": "停 · 结果全 0/空", "sublabel": "anomaly 原样呈现", "tag": "问数据或确认拆分占比", "width": 172 },
    { "id": "frozen", "lane": "session", "col": 5, "type": "database", "label": "冻结生效 · 进入派发", "sublabel": "门 2 通过", "tag": "→ 派发协议", "width": 180 }
  ],
  "edges": [
    { "id": "e_planner_runner", "from": "planner", "to": "runner", "variant": "default", "role": "main" },
