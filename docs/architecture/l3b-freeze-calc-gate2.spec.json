    { "id": "e_state_gate", "from": "state_write", "to": "gate2", "variant": "default", "role": "main" },
    { "id": "e_gate_frozen", "from": "gate2", "to": "frozen", "label": "rc=0", "variant": "emphasis", "role": "main", "fromSide": "right", "toSide": "left" },
    { "id": "e_gate_confirm", "from": "gate2", "to": "confirm", "label": "rc=3", "variant": "default", "role": "branch", "fromSide": "top", "toSide": "left" },
    { "id": "e_confirm_frozen", "from": "confirm", "to": "frozen", "label": "用户确认", "variant": "default", "role": "return", "fromSide": "bottom", "toSide": "top" },
    { "id": "e_gate_zero", "from": "gate2", "to": "halt_zero", "label": "全 0/空", "variant": "dashed", "role": "error", "fromSide": "bottom", "toSide": "bottom" }
