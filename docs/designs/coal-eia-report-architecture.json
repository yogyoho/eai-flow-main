  "cards": [
    {
      "dot": "cyan",
      "title": "参考真源",
      "items": [
        "stages/<stage>.json 是唯一结构真源，KF 模板为其派生工件",
        "standards_index 枚举标准号/限值；depth_targets 是章地板合同",
        "范文实体/数值禁入正文（sample_entities 注册表）"
      ]
    },
    {
      "dot": "emerald",
      "title": "脚本唯一写者",
      "items": [
        "data/ 只有 ingest.py 写；formula_state 只有 formula_runner 写",
        "progress.json 是控制器唯一事实源，续跑不靠对话记忆",
        "组装必须 build_output 收尾，禁手拼 outputs/"
      ]
    },
    {
      "dot": "rose",
      "title": "门与铁律",
      "items": [
        "门1 完备性 → 门2 anomalies 呈现 → 章门批量 → 终验一次报齐",
        "数字永不经过 LLM：正文只写 {{SLOT}}/{{TABLE}}，残留=0",
        "门 FAIL 只有补写节稿或用户批准降档两条合法出路"
      ]
    }
  ]
