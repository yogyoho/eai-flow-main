      "enabled": true,
      "type": "http",
      "command": null,
      "args": [],
      "env": {},
      "cwd": null,
      "url": "http://knowledge-factory:8765/mcp",
      "headers": {},
      "oauth": null,
      "description": "Knowledge factory template resolution and domain listing tools for report generation (HTTP long-lived process — no cold-start race)",
      "routing": {
        "mode": "prefer",
        "priority": 80,
        "keywords": [
          "标准",
          "规范",
          "法规",
          "行业标准",
          "国标",
          "知识库",
          "检索",
          "GB",
          "GB/T",
          "DZ",
          "DZ/T",
          "HG",
          "HG/T",
          "DL",
          "TB",
          "报告样例",
          "历史报告",
          "项目资料",
          "合同条款",
          "地质矿产"
        ]
      }
    },
    "word-document-server": {
      "enabled": false,
      "type": "stdio",
      "command": "/app/backend/.venv/bin/python",
      "args": [
        "/app/mcp-server/Office-Word-MCP-Server/word_mcp_server.py"
