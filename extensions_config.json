      "env": {},
      "cwd": "/app/backend",
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "Ops diagnosis read-only tools (thread run inventory + run event stream) over the harness runs/run_events tables. TRUST BOUNDARY v1: stdio session carries no caller identity — enabled servers let any agent read any user's thread events. Intranet admin/ops deployments only."
    }
