{
  "mcpServers": {
    "filesystem": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/allowed/files"
      ],
      "env": {},
      "cwd": null,
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "Provides filesystem access within allowed directories"
    },
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": ""
      },
      "cwd": null,
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "cwd": null,
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "PostgreSQL database access"
    },
    "project": {
      "enabled": true,
      "type": "stdio",
      "command": "/app/backend/.venv/bin/python",
      "args": [
        "-m",
        "app.extensions.project.mcp"
      ],
      "env": {
        "PROJECT_DB_URL": "postgresql+asyncpg://agentflow:agentflow123@postgres-ext:5432/agentflow"
      },
      "cwd": "/app/backend",
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "Project chapter read/write tools for report writing agent"
    },
    "data_sources": {
      "enabled": true,
