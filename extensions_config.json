      "env": {
        "PYTHONPATH": "/app/mcp-server/Office-Word-MCP-Server",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "cwd": "/app/mcp-server/Office-Word-MCP-Server",
      "url": null,
      "headers": {},
      "oauth": null,
      "description": "Word document creation (54 tools)"
    },
    "cad": {
      "enabled": true,
      "type": "http",
      "command": null,
      "args": [],
      "env": {},
      "cwd": null,
      "url": "http://cad:8003/mcp",
      "headers": {},
      "oauth": null,
      "description": "CAD Comprehension / EDP MCP (merged cad-suite image): analyze_cad DXF parse + rasterize, cad_compose_drawing 2D engineering drawings with domain packs (mine/chem). Part of the `cad-suite` container (alias `cad` -> :8003); see docker-compose-dev.yaml cad-suite service."
    },
    "text-to-cad": {
      "enabled": true,
      "type": "http",
      "command": null,
      "args": [],
      "env": {},
      "cwd": null,
      "url": "http://text-to-cad:8004/mcp",
      "headers": {},
      "oauth": null,
      "description": "text-to-cad MCP (merged cad-suite image): build123d STEP/STL/DXF generation (create_step gen_step contract, +also_glb/also_stl), inspect_step refs/measure/align/frame, snapshot_step PNG renders, search_step_parts catalog, check_printability DfAM facts. Service `cad-suite` in docker-compose-dev.yaml (supervises text-to-cad :8004 + cad :8003 + viewer :4178; aliases keep these URLs stable)."
    },
    "ops-diagnosis": {
      "enabled": true,
      "type": "stdio",
      "command": "/app/backend/.venv/bin/python",
