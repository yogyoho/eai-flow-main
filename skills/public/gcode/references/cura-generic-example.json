{
  "id": "eai_generic_example_not_a_real_printer",
  "name": "EAI Generic Example (STRUCTURAL EXAMPLE, NOT A REAL PRINTER)",
  "version": 2,
  "author": "EAI vendored example, written after the Cura fdmprinter definition format",
  "license": "MIT",
  "metadata": {
    "type": "example",
    "warning": "This file illustrates the native_config contract shape for CuraEngine (-j definition file). It is a generic fictional 180x180x180 printer and has NOT been validated against a real CuraEngine build. Before enabling the gcode skill, obtain a REAL native profile (a full fdmprinter.def.json plus base definitions from a real Cura installation, or a printer-vendor definition) and pass that as native_config. Never present this example, or any invented profile, as a real printer profile.",
    "length_unit": "millimeters; CuraEngine converts to internal microns when reading definition settings"
  },
  "settings": {
    "machine_name": { "default_value": "EAI Generic Example" },
    "machine_width": { "default_value": 180 },
    "machine_depth": { "default_value": 180 },
    "machine_height": { "default_value": 180 },
    "machine_center_is_zero": { "default_value": false },
    "machine_gcode_flavor": { "default_value": "RepRap (Marlin)" },
    "machine_heated_bed": { "default_value": true },
    "machine_extruder_count": { "default_value": 1 },
    "machine_nozzle_id": { "default_value": "0.4mm" },
    "machine_nozzle_size": { "default_value": 0.4 },
    "machine_max_feedrate_x": { "default_value": [500, 500, 40] },
    "machine_max_feedrate_y": { "default_value": [500, 500, 40] },
    "machine_max_feedrate_z": { "default_value": [40, 40, 40] },
    "machine_acceleration": { "default_value": 3000 },
    "machine_start_gcode": {
      "default_value": "G28 ; home all axes\nG92 E0 ; reset extruder\nG1 Z2.0 F3000 ; lift nozzle after homing"
    },
    "machine_end_gcode": {
      "default_value": "M104 S0 ; turn off nozzle heater\nM140 S0 ; turn off bed heater\nG28 X0 Y0 ; home X and Y\nM84 ; disable motors"
    },
    "extruder_prime_pos_z": { "default_value": 0 },
    "material_diameter": { "default_value": 1.75 },
    "material_flow": { "default_value": 100 },
    "material_print_temperature": { "default_value": 200 },
    "material_print_temperature_layer_0": { "default_value": 205 },
    "material_bed_temperature": { "default_value": 60 },
    "material_bed_temperature_layer_0": { "default_value": 65 },
    "retraction_enable": { "default_value": true },
    "retraction_amount": { "default_value": 5 },
    "retraction_speed": { "default_value": 45 },
    "retraction_hop": { "default_value": 0 },
    "layer_height": { "default_value": 0.2 },
    "layer_height_0": { "default_value": 0.3 },
    "line_width": { "default_value": 0.4 },
    "wall_line_count": { "default_value": 2 },
    "wall_line_width_0": { "default_value": 0.4 },
    "top_layers": { "default_value": 4 },
    "bottom_layers": { "default_value": 3 },
    "top_bottom_thickness": { "default_value": 0.8 },
    "infill_sparse_density": { "default_value": 20 },
    "infill_pattern": { "default_value": "grid" },
    "speed_print": { "default_value": 50 },
    "speed_infill": { "default_value": 50 },
    "speed_wall": { "default_value": 30 },
    "speed_topbottom": { "default_value": 30 },
    "speed_travel": { "default_value": 120 },
    "speed_layer_0": { "default_value": 25 },
    "speed_z_hop": { "default_value": 15 },
    "acceleration_print": { "default_value": 3000 },
    "acceleration_travel": { "default_value": 5000 },
    "jerk_print": { "default_value": 10 },
    "jerk_travel": { "default_value": 15 },
    "adhesion_type": { "default_value": "brim" },
    "brim_width": { "default_value": 4 },
    "support_enable": { "default_value": false },
    "cool_fan_enabled": { "default_value": true },
    "cool_fan_speed": { "default_value": 100 },
    "cool_fan_speed_0": { "default_value": 0 },
    "cool_fan_full_layer": { "default_value": 3 },
    "cool_min_layer_time": { "default_value": 5 }
  }
}
