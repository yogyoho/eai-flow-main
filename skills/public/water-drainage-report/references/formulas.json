      },
      "outputs": {"pipe_d_blowdown": "mm"}
    },
    {
      "id": "pipe_v_blowdown",
      "name": "排污水管流速校核",
      "section": "6.1.5",
      "symbol": "v",
      "citation": [],
      "expression": "Qb / (3600 * pi * (DN_blowdown / 2000) ** 2)",
      "inputs": {
        "Qb": {"type": "formula_output", "source_formula_id": "Qb", "source_param_name": "Qb"},
        "DN_blowdown": {"type": "user_input", "value": 100, "unit": "mm", "symbol": "DN", "source": "管径规格系列试选（依据 pipe_d_blowdown 计算值就近上靠，需用户确认）", "description": "排污水管公称直径", "needs_verification": true}
      },
      "outputs": {"pipe_v_blowdown": "m/s"}
    },
    {
      "id": "Q_connect",
      "name": "连通管单管流量",
      "section": "7.1.2",
      "symbol": "Q_{c}",
      "citation": [
        {"code": "GB 50648-2011", "clause": "7.3.3", "text": "塔下水池与吸水池间过水廊道的过水流量应满足循环冷却水泵组最大小时吸水量，过水断面流速宜为0.8~1.0m/s；过水廊道（管道）不宜少于两条"}
      ],
