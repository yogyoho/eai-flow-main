{
  "description": "循环水装置给排水设计计算 — 公式定义集（v2：配管选径/滤网起吊/泵房高度/喇叭口/反洗配套链，全部条款号经样例计算书逐字核实）",
  "source": "GB/T 50746-2012 石油化工循环水场设计规范",
  "citation_schema": "citation 数组：{code(规范号), clause(条款号，可空), text(限值摘要)}；clause 仅收录经样例/原文核实的条号，未核实的只写 code+text 绝不编造",
  "formulas": [
    {
      "id": "Qe",
      "name": "蒸发水量",
      "section": "6.1.1",
      "symbol": "Q_{e}",
      "citation": [
        {"code": "GB/T 50746-2012", "clause": "3.3.3", "text": "蒸发水量按循环水量×蒸发损失系数×进出水温差计算，KZF 按表3.3.3取值，气温为中间值时采用内插法"},
        {"code": "GB 50648-2011", "clause": "4.2.1", "text": "蒸发损失量计算"}
      ],
      "expression": "Q * KZF * delta_t",
      "inputs": {
        "Q": {"type": "user_input", "value": null, "unit": "m3/h", "symbol": "Q", "description": "循环水设计水量"},
        "KZF": {"type": "lookup_table", "value": 0.001461, "unit": "1/℃", "symbol": "K_{ZF}", "source": "GB/T 50746-2012 表3.3.3 内插", "description": "蒸发损失系数", "needs_verification": false},
        "delta_t": {"type": "user_input", "value": null, "unit": "℃", "symbol": "\\Delta t", "description": "冷却塔进出水温差"}
      },
      "outputs": {"Qe": "m3/h"}
    },
    {
      "id": "Qw",
      "name": "风吹损失水量",
      "section": "6.1.2",
      "symbol": "Q_{w}",
      "citation": [
        {"code": "GB/T 50746-2012", "clause": "3.3.4", "text": "冷却塔风吹损失水量，机械通风冷却塔按0.1%计算"}
      ],
      "expression": "Q * drift_rate",
      "inputs": {
        "Q": {"type": "user_input", "value": null, "unit": "m3/h", "symbol": "Q", "description": "循环水设计水量"},
        "drift_rate": {"type": "code_requirement", "value": 0.001, "unit": "—", "symbol": "\\eta", "source": "工程经验（飘水率与除水器效率相关，常规 0.01%~0.1%；本项目取 0.1% 需核实）", "description": "风吹（飘水）损失率", "needs_verification": true}
      },
      "outputs": {"Qw": "m3/h"}
    },
    {
      "id": "Qb",
      "name": "排污水量",
      "section": "6.1.3",
      "symbol": "Q_{b}",
      "citation": [
        {"code": "GB/T 50746-2012", "clause": "3.3.5", "text": "排污水量应根据循环冷却水水质和浓缩倍数的要求经计算确定"}
      ],
      "expression": "Qe / (N - 1)",
      "inputs": {
        "Qe": {"type": "formula_output", "source_formula_id": "Qe", "source_param_name": "Qe"},
        "N": {"type": "user_input", "value": null, "unit": "—", "symbol": "N", "description": "浓缩倍数，宜≥5.0且不应低于3.0"}
      },
      "outputs": {"Qb": "m3/h"}
    },
    {
      "id": "Qm",
      "name": "补充水量",
      "section": "6.1.4",
      "symbol": "Q_{m}",
      "citation": [
        {"code": "GB/T 50746-2012", "clause": "3.3.2", "text": "补充水量 = 蒸发水量 + 风吹损失水量 + 排污水量"}
      ],
      "expression": "Qe + Qw + Qb",
      "inputs": {
        "Qe": {"type": "formula_output", "source_formula_id": "Qe", "source_param_name": "Qe"},
        "Qw": {"type": "formula_output", "source_formula_id": "Qw", "source_param_name": "Qw"},
        "Qb": {"type": "formula_output", "source_formula_id": "Qb", "source_param_name": "Qb"}
      },
      "outputs": {"Qm": "m3/h"}
    },
    {
      "id": "pipe_d_makeup",
      "name": "补充水管选径",
      "section": "6.1.5",
      "symbol": "D",
      "citation": [],
      "expression": "1000 * sqrt(4 * Qm / (3600 * pi * v_makeup))",
      "inputs": {
        "Qm": {"type": "formula_output", "source_formula_id": "Qm", "source_param_name": "Qm"},
        "v_makeup": {"type": "user_input", "value": 1.5, "unit": "m/s", "symbol": "v", "source": "工程经验（补充水管流速 1.0~2.0 m/s，默认取1.5）", "description": "补充水管设计流速", "needs_verification": true}
      },
      "outputs": {"pipe_d_makeup": "mm"}
    },
    {
      "id": "pipe_v_makeup",
      "name": "补充水管流速校核",
      "section": "6.1.5",
      "symbol": "v",
      "citation": [],
      "expression": "Qm / (3600 * pi * (DN_makeup / 2000) ** 2)",
      "inputs": {
        "Qm": {"type": "formula_output", "source_formula_id": "Qm", "source_param_name": "Qm"},
        "DN_makeup": {"type": "user_input", "value": 300, "unit": "mm", "symbol": "DN", "source": "管径规格系列试选（依据 pipe_d_makeup 计算值就近上靠，需用户确认）", "description": "补充水管公称直径", "needs_verification": true}
      },
      "outputs": {"pipe_v_makeup": "m/s"}
    },
    {
